[
  {
    "name": "Search and read a known public job",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Find Frontend Developer jobs in New York, then return the complete details for job-001."
      }
    ],
    "expectedCall": [
      {
        "ordered": [
          {
            "functionName": "search_jobs",
            "arguments": {
              "query": "Frontend Developer",
              "location": "New York"
            }
          },
          {
            "functionName": "get_jobs",
            "arguments": { "jobIds": ["job-001"] }
          }
        ]
      }
    ]
  },
  {
    "name": "Apply non-mutating job filters",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Show the top three remote senior B2B jobs, sorted by highest salary."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_jobs",
        "arguments": {
          "seniority": ["senior"],
          "workplace": ["remote"],
          "contracts": ["b2b"],
          "sort": "salary-desc"
        }
      },
      {
        "functionName": "get_jobs",
        "arguments": {
          "jobIds": [
            { "$pattern": "^job-\\d{3}$" },
            { "$pattern": "^job-\\d{3}$" },
            { "$pattern": "^job-\\d{3}$" }
          ]
        },
        "optional": true
      }
    ]
  },
  {
    "name": "Search and visually highlight a public job",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Find Frontend Developer jobs in New York and highlight job-001 on the map."
      }
    ],
    "expectedCall": [
      {
        "ordered": [
          {
            "functionName": "search_jobs",
            "arguments": {
              "query": "Frontend Developer",
              "location": "New York"
            }
          },
          {
            "functionName": "highlight_job",
            "arguments": { "jobId": "job-001" }
          }
        ]
      }
    ]
  }
]
