[
  {
    "name": "Search jobs by query and location",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Find Frontend Developer jobs in New York within 50 miles."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_jobs",
        "arguments": {
          "query": "Frontend Developer",
          "location": "New York",
          "radiusMi": 50
        }
      }
    ]
  },
  {
    "name": "Filter jobs with structured criteria",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Only show senior remote B2B roles paying at least 5000 USD per month, with the highest salary first."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_jobs",
        "arguments": {
          "seniority": ["senior"],
          "workplace": ["remote"],
          "contracts": ["b2b"],
          "salaryMin": 5000,
          "sort": "salary-desc"
        }
      }
    ]
  },
  {
    "name": "Read job details instead of inspecting the page",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Give me the complete details for job-001 before I decide what to do."
      }
    ],
    "expectedCall": [
      {
        "ordered": [
          {
            "functionName": "get_jobs",
            "arguments": { "jobIds": ["job-001"] }
          },
          {
            "functionName": "highlight_job",
            "arguments": { "jobId": "job-001" }
          }
        ]
      }
    ]
  },
  {
    "name": "Show where a job is located on the map",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Where is job-001 located? Show me on the map."
      }
    ],
    "expectedCall": [
      {
        "functionName": "highlight_job",
        "arguments": { "jobId": "job-001" }
      }
    ]
  },
  {
    "name": "Answer a location question in Polish",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Gdzie znajduje się oferta job-001 albo siedziba tej firmy?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "highlight_job",
        "arguments": { "jobId": "job-001" }
      }
    ]
  },
  {
    "name": "Present one recommended job on the map",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Job-001 looks like the best match for me — show me that offer on the map."
      }
    ],
    "expectedCall": [
      {
        "functionName": "highlight_job",
        "arguments": { "jobId": "job-001" }
      }
    ]
  },
  {
    "name": "Highlight a recommended job on the map",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Show me which offer you recommend by highlighting job-001 on the current jobs map."
      }
    ],
    "expectedCall": [
      {
        "functionName": "highlight_job",
        "arguments": { "jobId": "job-001" }
      }
    ]
  },
  {
    "name": "Compare offers with agent feedback on the page",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Compare job-001 and job-002 for me and show your recommendation on the page. Mark job-001 as najlepsza."
      }
    ],
    "expectedCall": [
      {
        "ordered": [
          {
            "functionName": "compare_offers",
            "arguments": {
              "summary": "job-001 is the strongest match overall.",
              "offers": [
                { "jobId": "job-001", "badge": "najlepsza" },
                { "jobId": "job-002" }
              ]
            }
          },
          {
            "functionName": "highlight_job",
            "arguments": { "jobId": "job-001" }
          }
        ]
      }
    ]
  },
  {
    "name": "Read saved jobs without mixing them into the profile",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Which job offers have I saved?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_saved_jobs",
